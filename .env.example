# Entorno: development | production
APP_ENV=development

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=sysai

# SMTP (recuperación de contraseña).
# Dejar MAIL_USERNAME / MAIL_PASSWORD vacíos en desarrollo:
# el token se registra en includes/logs/mail.log y no se envía correo real.
#
# ⚠️ EN PRODUCCIÓN ESTO NO ES OPCIONAL: el alta de usuarios genera una contraseña
# aleatoria que nadie conoce, así que la ÚNICA forma de activar una cuenta es el
# código que llega por correo (/chgpsswd). Sin SMTP, nadie puede entrar.
#
# Gmail: la contraseña del correo NO sirve. Hay que activar la verificación en 2
# pasos y generar una "Contraseña de aplicación" de 16 caracteres
# (https://myaccount.google.com/apppasswords). Además, Gmail reescribe el
# remitente: MAIL_FROM_EMAIL debe ser la MISMA cuenta de MAIL_USERNAME.
# Puertos: 587 con MAIL_SECURE=tls (STARTTLS) o 465 con MAIL_SECURE=ssl.
#
# Hostinger (casilla del dominio): MAIL_HOST=smtp.hostinger.com, puerto 465, ssl.
#
# Verificar la configuración sin pasar por el navegador:
#   php database/smtp_test.php  destinatario@ejemplo.com
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_FROM_EMAIL=no-reply@sysai.local
MAIL_FROM_NAME=Área de TI - Arca
# MAIL_DEBUG=1 vuelca el diálogo SMTP completo al error_log (solo para
# diagnosticar un envío que falla; dejar vacío en operación normal).
MAIL_DEBUG=

# Consulta de tipo de cambio SBS (INFORMATIVA — Fase 6 del plan de montos).
# Plantilla de URL con {moneda} y {fecha}; la respuesta debe ser JSON con los
# campos compra/venta (se toleran precioCompra/precioVenta y buy/sell).
# Vacío = deshabilitada: el botón "Consultar SBS" avisa y se teclea manual.
# Nunca se consulta desde un reporte; timeout 5 s y degradación limpia.
# Ejemplo: SBS_API_URL=https://api.ejemplo.pe/tc?moneda={moneda}&fecha={fecha}
SBS_API_URL=
