# Entorno: development | production
APP_ENV=development

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=sysai

# SMTP (recuperación de contraseña).
# Dejar MAIL_USERNAME / MAIL_PASSWORD vacíos en desarrollo:
# el token se registra en includes/logs/mail.log y no se envía correo real.
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_FROM_EMAIL=no-reply@sysai.local
MAIL_FROM_NAME=Área de TI - Arca

# Consulta de tipo de cambio SBS (INFORMATIVA — Fase 6 del plan de montos).
# Plantilla de URL con {moneda} y {fecha}; la respuesta debe ser JSON con los
# campos compra/venta (se toleran precioCompra/precioVenta y buy/sell).
# Vacío = deshabilitada: el botón "Consultar SBS" avisa y se teclea manual.
# Nunca se consulta desde un reporte; timeout 5 s y degradación limpia.
# Ejemplo: SBS_API_URL=https://api.ejemplo.pe/tc?moneda={moneda}&fecha={fecha}
SBS_API_URL=
