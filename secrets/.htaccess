# Denegación directa de toda esta carpeta, sin depender de mod_rewrite.
#
# Aquí vive secrets/.env.enc: el .env CIFRADO que viaja en el repositorio para
# poder moverse entre equipos (ver scripts/env.js). Está cifrado con AES-256,
# así que servirlo no entrega la configuración de inmediato — pero entregarlo
# le da a un atacante material para atacar la passphrase sin prisa y sin que
# nadie lo note. No hay ninguna razón para que sea alcanzable por HTTP.
#
# Doble regla a propósito: el proyecto tiene que funcionar tanto en Apache 2.4
# (Require) como en instalaciones con mod_access_compat (Order/Deny).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
